# Copia este archivo como .streamlit/secrets.toml (no se sube al repositorio) o pega su
# contenido en Streamlit Cloud › tu app › Settings › Secrets. Todo es opcional.

# Clave para entrar a la plataforma. Sin clave, cualquiera con el link puede verla.
clave = "elige-una-clave-larga"

# De dónde leer los datos (por defecto, la rama `datos` del repositorio en GitHub).
# datos = "https://raw.githubusercontent.com/Yakazor/MercadoPublico/datos"

# Tus datos de comprador para la orden de compra al proveedor.
[comprador]
tipo = "persona_natural"        # o "empresa" (con razon_social y direccion)
nombre = "Nombre Apellido Apellido"
rut = "11.111.111-1"
giro = "Venta al por mayor no especializada"
domicilio = "Calle 123, Comuna, Región"
contacto = "+56 9 0000 0000, correo@ejemplo.cl"

# Firma de los correos a proveedores.
[remitente]
empresa = "Mi Empresa"
nombre = "Nombre Apellido"
cargo = "Gerente"
contacto = "+56 9 0000 0000 · correo@ejemplo.cl"
